# code: language=yaml
#
# Compute $state.status from observed resource state.
#

{{- $eff := $state.spec.effective }}
{{- $obs := $state.observed }}

{{- $ready := and
  ($obs.identity.ready | default false)
  ($obs.user.ready | default false)
  ($obs.policy.ready | default false)
  ($obs.attachment.ready | default false)
  ($obs.accessKey.ready | default false)
}}
{{- if $eff.pushCredentials.enabled }}
  {{- $ready = and $ready ($obs.secret.ready | default false) ($obs.secretVersion.ready | default false) }}
{{- end }}
{{- if $eff.dedicatedIpPool.enabled }}
  {{- $ready = and $ready ($obs.dedicatedIpPool.ready | default false) ($obs.configurationSet.ready | default false) }}
{{- end }}

# Cloudflare DKIM records: ready only when enabled, all 3 tokens observed, and
# all 3 records reconciled. Folded into overall readiness only when enabled.
{{- $cfDkimEnabled := $eff.cloudflare.dkim.enabled }}
{{- $dkimRecordsReady := false }}
{{- $dkimRecordsStatus := list }}
{{- if $cfDkimEnabled }}
  {{- $dkimRecordsReady = true }}
  {{- $tokens := ($obs.identity.dkimTokens | default list) }}
  {{- if ne (len $tokens) 3 }}
    {{- $dkimRecordsReady = false }}
  {{- end }}
  {{- range $index, $token := $tokens }}
    {{- $i := add $index 1 }}
    {{- $rec := get ($obs.dkimRecords | default dict) (printf "dkim-%d" $i) | default dict }}
    {{- if not ($rec.ready | default false) }}
      {{- $dkimRecordsReady = false }}
    {{- end }}
    {{- $dkimRecordsStatus = append $dkimRecordsStatus (dict
      "name" (printf "%s._domainkey.%s" $token $eff.domain)
      "value" (printf "%s.dkim.amazonses.com" $token)
      "cloudflareRecordId" ($rec.id | default "")
    ) }}
  {{- end }}
  {{- $ready = and $ready $dkimRecordsReady }}
{{- end }}

{{- $state = set $state "status" (dict
  "ready" $ready
  "smtp" (dict
    "host" (printf "email-smtp.%s.amazonaws.com" $eff.region)
    "port" 587
    "username" ($obs.accessKey.username | default "")
    "awsSecretsManagerPath" $eff.pushCredentials.path
  )
  "dkim" (dict
    "verified" ($obs.identity.verifiedForSendingStatus | default false)
    "verificationStatus" ($obs.identity.verificationStatus | default "")
    "status" ($obs.identity.dkimStatus | default "")
    "tokens" ($obs.identity.dkimTokens | default list)
    "recordsReady" $dkimRecordsReady
    "records" $dkimRecordsStatus
  )
  "iam" (dict
    "userArn" ($obs.user.arn | default "")
    "policyArn" ($obs.policy.arn | default "")
  )
  "ses" (dict
    "identityArn" ($obs.identity.arn | default "")
    "dedicatedIpPool" (dict
      "arn" ($obs.dedicatedIpPool.arn | default "")
      "name" ($obs.dedicatedIpPool.id | default "")
      "scalingMode" ($obs.dedicatedIpPool.scalingMode | default "")
    )
    "configurationSet" (dict
      "arn" ($obs.configurationSet.arn | default "")
      "name" ($obs.configurationSet.id | default "")
    )
  )
  "secret" (dict
    "arn" ($obs.secret.arn | default "")
  )
) }}
