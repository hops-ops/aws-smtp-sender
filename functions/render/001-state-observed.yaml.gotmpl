{{- $secretResource := $secretEntry.resource | default dict }}
{{- $secretStatus := $secretResource.status | default dict }}
{{- $secretAtProvider := $secretStatus.atProvider | default dict }}
{{- $secretReady := false }}
{{- range ($secretStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $secretReady = true }}
  {{- end }}
{{- end }}
{{- $state = set $state "observed" (merge $state.observed (dict "secret" (dict
  "ready" $secretReady
  "arn" ($secretAtProvider.arn | default ($secretAtProvider.id | default ""))
