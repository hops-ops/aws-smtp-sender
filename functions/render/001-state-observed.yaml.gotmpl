# code: language=yaml
#
# Set observed resource slices from Crossplane observed state.
#

{{- $raw := $.observed.resources | default dict }}

# ==============================================================================
# SES identity
# ==============================================================================
{{- $identityEntry := get $raw "email-identity" | default dict }}
{{- $identityResource := $identityEntry.resource | default dict }}
{{- $identityStatus := $identityResource.status | default dict }}
{{- $identityAtProvider := $identityStatus.atProvider | default dict }}
{{- $identityReady := false }}
{{- range ($identityStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $identityReady = true }}
  {{- end }}
{{- end }}
{{- $dkimAttributes := $identityAtProvider.dkimSigningAttributes | default dict }}
{{- if kindIs "slice" $dkimAttributes }}
  {{- $dkimAttributes = (first $dkimAttributes | default dict) }}
{{- end }}
{{- $state = set $state "observed" (merge $state.observed (dict "identity" (dict
  "ready" $identityReady
  "arn" ($identityAtProvider.arn | default "")
  "verifiedForSendingStatus" ($identityAtProvider.verifiedForSendingStatus | default false)
  "verificationStatus" ($identityAtProvider.verificationStatus | default "")
  "dkimStatus" ($dkimAttributes.status | default "")
  "dkimTokens" ($dkimAttributes.tokens | default list)
))) }}

# ==============================================================================
# IAM user
# ==============================================================================
{{- $userEntry := get $raw "iam-user" | default dict }}
{{- $userResource := $userEntry.resource | default dict }}
{{- $userStatus := $userResource.status | default dict }}
{{- $userAtProvider := $userStatus.atProvider | default dict }}
{{- $userReady := false }}
{{- range ($userStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $userReady = true }}
  {{- end }}
{{- end }}
{{- $state = set $state "observed" (merge $state.observed (dict "user" (dict
  "ready" $userReady
  "arn" ($userAtProvider.arn | default "")
  "id" ($userAtProvider.id | default "")
))) }}

