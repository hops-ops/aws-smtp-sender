{{- $attachmentResource := $attachmentEntry.resource | default dict }}
{{- $attachmentStatus := $attachmentResource.status | default dict }}
{{- $attachmentAtProvider := $attachmentStatus.atProvider | default dict }}
{{- $attachmentReady := false }}
{{- range ($attachmentStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $attachmentReady = true }}
