# ==============================================================================
# AWS Secrets Manager secret version
# ==============================================================================
{{- $secretVersionEntry := get $raw "secrets-manager-secret-version" | default dict }}
{{- $secretVersionResource := $secretVersionEntry.resource | default dict }}
{{- $secretVersionStatus := $secretVersionResource.status | default dict }}
{{- $secretVersionAtProvider := $secretVersionStatus.atProvider | default dict }}
{{- $secretVersionReady := false }}
{{- range ($secretVersionStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $secretVersionReady = true }}
  {{- end }}
