{{- range ($secretVersionStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $secretVersionReady = true }}
  {{- end }}
{{- end }}
{{- $state = set $state "observed" (merge $state.observed (dict "secretVersion" (dict
  "ready" $secretVersionReady
  "id" ($secretVersionAtProvider.id | default "")
