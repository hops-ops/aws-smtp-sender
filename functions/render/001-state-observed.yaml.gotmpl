# IAM access key
# ==============================================================================
{{- $accessKeyEntry := get $raw "iam-access-key" | default dict }}
{{- $accessKeyResource := $accessKeyEntry.resource | default dict }}
{{- $accessKeyStatus := $accessKeyResource.status | default dict }}
{{- $accessKeyAtProvider := $accessKeyStatus.atProvider | default dict }}
{{- $accessKeyConnection := $accessKeyEntry.connectionDetails | default dict }}
{{- $accessKeyReady := false }}
{{- range ($accessKeyStatus.conditions | default list) }}
  {{- if and (eq .type "Ready") (eq .status "True") }}
    {{- $accessKeyReady = true }}
