# code: language=yaml
#
# Output computed status to the XR.
#

{{- $xr := getCompositeResource . }}
{{- $s := $state.status }}

---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $xr.kind }}
status:
  ready: {{ $s.ready }}
  smtp:
    host: {{ $s.smtp.host | quote }}
    port: {{ $s.smtp.port }}
    username: {{ $s.smtp.username | quote }}
    awsSecretsManagerPath: {{ $s.smtp.awsSecretsManagerPath | quote }}
  dkim:
    verified: {{ $s.dkim.verified }}
    verificationStatus: {{ $s.dkim.verificationStatus | quote }}
    status: {{ $s.dkim.status | quote }}
    tokens: {{ $s.dkim.tokens | toJson }}
    recordsReady: {{ $s.dkim.recordsReady }}
    records: {{ $s.dkim.records | toJson }}
  iam:
    userArn: {{ $s.iam.userArn | quote }}
    policyArn: {{ $s.iam.policyArn | quote }}
  ses:
    identityArn: {{ $s.ses.identityArn | quote }}
    dedicatedIpPool:
      arn: {{ $s.ses.dedicatedIpPool.arn | quote }}
      name: {{ $s.ses.dedicatedIpPool.name | quote }}
      scalingMode: {{ $s.ses.dedicatedIpPool.scalingMode | quote }}
    configurationSet:
      arn: {{ $s.ses.configurationSet.arn | quote }}
      name: {{ $s.ses.configurationSet.name | quote }}
  secret:
    arn: {{ $s.secret.arn | quote }}
